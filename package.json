{
  "name": "audio-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "audio-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:studio",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "build:studio": "node scripts/build-studio.mjs",
    "studio": "node scripts/serve-studio.mjs",
    "test:studio": "npm run build && playwright test -c web-test/playwright.config.mjs",
    "package:studio": "node scripts/build-studio.mjs --package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "midi-file": "1.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
